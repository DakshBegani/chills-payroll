{
  "name": "chills-payroll-backend",
  "version": "1.0.0",
  "description": "Backend API for Chills Payroll",
  "main": "main.js",
  "author": "Chills Payroll",
  "scripts": {
    "start": "electron .",
    "dev": "node index.js",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.chills.payrollserver",
    "productName": "Chills Payroll Server",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}
